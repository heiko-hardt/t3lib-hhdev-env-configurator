// Reference: https://containers.dev/implementors/json_reference/
// Templates: https://github.com/devcontainers/templates/tree/main/src/debian
// Image:     https://github.com/devcontainers/images/tree/main/src/base-debian
{
	// https://containers.dev/implementors/json_reference/#general-properties
	"name": "T3Lib: TYPO3 env configurator",
	"containerEnv": {
		// used for the default shell in the container
		"HHConf": "example"
	},
	"remoteUser": "developer",
	"customizations": {
		"vscode": {
			"extensions": [
				// PHP
				"bmewburn.vscode-intelephense-client",
				"recca0120.vscode-phpunit",
				"xdebug.php-debug",
				// Formatters
				"EditorConfig.EditorConfig",
				"esbenp.prettier-vscode"
			]
		}
	},
	// Docker Compose specific properties
	// https://containers.dev/implementors/json_reference/#image-specific
	"build": {
		"dockerfile": "dockerfile.web"
	},
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"runArgs": [
		"--name=heikohardt-t3lib-env-configurator"
	]
}
