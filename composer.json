{
	"name": "heikohardt/typo3-env-configurator",
	"description": "Parses typed TYPO3__* environment variables into a nested config array for merging into TYPO3_CONF_VARS.",
	"license": "GPL-2.0-or-later",
	"type": "library",
	"keywords": [
		"TYPO3",
		"environment",
		"configuration",
		"TYPO3_CONF_VARS",
		"dotenv"
	],
	"authors": [
		{
			"name": "Heiko Hardt",
			"email": "heiko@hardt.dev"
		}
	],
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0"
	},
	"autoload": {
		"psr-4": {
			"HeikoHardt\\Typo3EnvConfigurator\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"HeikoHardt\\Typo3EnvConfigurator\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"branch-alias": {
			"dev-main": "1.0.x-dev"
		}
	}
}
